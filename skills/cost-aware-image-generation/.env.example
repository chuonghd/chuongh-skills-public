# API keys for cost-aware-image-generation.
#
# Copy this file to .env in this same skill folder and fill in the keys:
#   cp .env.example .env && chmod 600 .env
# .env is gitignored, so it never gets committed.
#
# Keys already exported in your shell take precedence over this file.
# Only one key is required; set both to use either provider.

# Gemini (Nano Banana) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (GPT Image) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
